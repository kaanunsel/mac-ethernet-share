<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>local.ps5share</string>
    <key>ProgramArguments</key>
    <array><string>/Library/PrivilegedHelperTools/local.ps5share/ps5shared</string><string>watch</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>ProcessType</key><string>Background</string>
    <key>ExitTimeOut</key><integer>30</integer>
    <key>Umask</key><integer>63</integer>
    <key>StandardOutPath</key><string>/var/log/ps5share.log</string>
    <key>StandardErrorPath</key><string>/var/log/ps5share.log</string>
</dict>
</plist>
